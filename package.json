{
  "name": "waitlist",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "client": "bun run --bun astro dev",
    "build:client": "bun run --bun astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently 'bun run client' 'bun run worker'",
    "dryrun:staging": "bun run build:client && wrangler deploy --dry-run --env staging",
    "dryrun:prod": "bun run build:client && wrangler deploy --dry-run --env production",
    "deploy:staging": "bun run build:client && wrangler deploy --env staging",
    "deploy:prod": "bun run build:client && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ai_job_reviewer_local_db --local",
    "db:migrate:staging": "wrangler d1 migrations apply ai_job_reviewer_staging_db --remote --env staging"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro": "^7.3.5",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "daisyui": "^5.7.47",
    "drizzle-kit": "^0.31.11",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
